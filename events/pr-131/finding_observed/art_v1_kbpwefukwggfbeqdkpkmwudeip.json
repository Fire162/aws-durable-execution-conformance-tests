{"data":{"body":"[P2] Do not require zero exception events for this failed callback span. OpenTelemetry permits instrumentation to record an `exception` event when the failure escapes the callback span, even if the service supplied an empty error payload and the enclosing workflow catches it. This rejects otherwise conformant SDKs. Remove `exception_event_count: 0` from both case-25 views and update the associated tests and documentation; retain the `ERROR` status assertion.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABA5Avpg","finding_digest":"e842bbb16b1c4f62f714d395462fb3ab97f9cc07c57ead0717654a5014a33471","finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","line":246,"observation_digest":"417082b2ca8cedb0f5927ac22d995da6cd77d1b37a0ee02469b30e9ff213d7fb","observation_id":"aro_v1_ifyifmwkrtw3b5msplbc3gk5u3","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml","prior_finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","published_at":"2026-10-22T23:54:25Z","review_id":"arr_v1_qilmsowup6c3z6orfv6sh4k57i","reviewed_base_sha":"d783de36587c37f7985ce3616da7faed0f0e3f15","reviewed_head_sha":"22bc321d1b61ea89a2dcded48db6cc871503e16e","reviewer":"codex","start_line":246,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_kbpwefukwggfbeqdkpkmwudeip","record_type":"finding_observed","recorded_at":"2026-10-22T23:54:25Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
