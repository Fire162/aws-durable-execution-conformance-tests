{"data":{"body":"[P2] Preserve service context for every backend failure. This handler writes it only for `TelemetryTimeout`; if X-Ray or S3 raises another `BackendError` after `load_execution_trace_contexts` succeeds, the independently observed child carrier is discarded and no telemetry artifact is written. Handle all `BackendError` instances here, using `latest_trace` when available and otherwise writing context-only evidence, and add a regression test for a backend lookup failure.","comment_node_id":"PRRC_kwDOTa1Cx87_BbSr","finding_digest":"bb28f3e18ffccc4f7c4e42d1b2a7d4da5e1cba409022e194dbc71930282ce61e","finding_id":"arf_v1_xmuphymp7tge67coili3fj6u3j","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::service-context-artifact-loss","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::service-context-artifact-loss","line":300,"observation_digest":"8a4dec4b5607a106ab513152f0c4d2dc14174b767c1cc331bb294aeca04103df","observation_id":"aro_v1_rjg6ys2wa6qqnk2rgfjpbrgs3q","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py","prior_finding_id":"arf_v1_xmuphymp7tge67coili3fj6u3j","published_at":"2026-10-15T02:59:57Z","review_id":"arr_v1_cveaalsu6a2evmogemvqy7ta2k","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"c22240dc3779bb11d3994ab0c99d46a6b27b7c28","reviewer":"codex","start_line":300,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_v2xbdt736lxslssswr6wrkbkbz","record_type":"finding_observed","recorded_at":"2026-10-15T02:59:57Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
