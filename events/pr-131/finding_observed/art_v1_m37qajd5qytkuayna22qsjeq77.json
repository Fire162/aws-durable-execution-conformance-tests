{"data":{"body":"[P2] This restricts keys inside link mappings but never requires `links`, or each `$any_of` branch, to have the serialized sequence shape. For example, `links: {$any_of: [[], {trace_id: '*', span_id: '*'}]}` passes prevalidation and can succeed via the empty branch even though the mapping branch can never match serialized links. Add a dedicated links matcher-schema validator that recursively rejects bare mapping alternatives and validates every branch's container shape.","comment_node_id":"PRRC_kwDOTa1Cx87-PosC","finding_digest":"ecb608542f8b18df07794fb312f48e270068d7cc0f8b5380af7e09a96edb6458","finding_id":"arf_v1_5s3aqvbprmmn6b3zj6zrf5eoe4","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py::_span_selector_schema_errors::serialized-links-container-shape","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py::_span_selector_schema_errors::serialized-links-container-shape","line":402,"observation_digest":"492b6e45c65557e7f3a447e6c189b75ef94e1b98f35bc2c7aaf6cc468a0b3719","observation_id":"aro_v1_jevw4rogkvl6p45ei7tmdcnxl3","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py","prior_finding_id":"","published_at":"2026-10-14T00:28:08Z","review_id":"arr_v1_rvgyclghgu4itwwyrwmm736vkx","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"75987d46a915bc37409eed3ea9c3617a924c9756","reviewer":"codex","start_line":402,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_m37qajd5qytkuayna22qsjeq77","record_type":"finding_observed","recorded_at":"2026-10-14T00:28:08Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
