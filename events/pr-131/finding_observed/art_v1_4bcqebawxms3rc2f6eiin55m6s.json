{"data":{"body":"[P2] Record whether ancestry validation actually ran, rather than whether the backend advertises support. Any returned X-Ray trace currently records `full_trace_ancestry_checked: true`, even when `_chained_invoke_errors` exits before `_descendant_errors` because the parent selector is ambiguous, service context is missing, or child Workflow/Invocation spans are absent. Propagate an explicit checked flag from validation\u2014true only after both required child chains are traversed\u2014and cover these early-return cases.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAiwhkg","finding_digest":"13cd1b59ec5dcc995052a422ada5923db356044fcfa1e07dcb2adc94e807177b","finding_id":"arf_v1_cpgrwwpmlxgjsucsuqrk3jmshw","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::_trace_evidence::ancestry-check-claim","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::_trace_evidence::ancestry-check-claim","line":72,"observation_digest":"35f02ce5535bc94a60d848cd37697c1a504e20f9f91a8d69af800760965a0a7a","observation_id":"aro_v1_gxyczzktlpeuuygyjdgto2l4dj","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py","prior_finding_id":"arf_v1_cpgrwwpmlxgjsucsuqrk3jmshw","published_at":"2026-10-20T23:27:26Z","review_id":"arr_v1_stktdivnc2fnjlo633nbx74sjv","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"c27adb2cd705249e6aa902fb1b9ef5fd59596622","reviewer":"codex","start_line":72,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_4bcqebawxms3rc2f6eiin55m6s","record_type":"finding_observed","recorded_at":"2026-10-20T23:27:26Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
