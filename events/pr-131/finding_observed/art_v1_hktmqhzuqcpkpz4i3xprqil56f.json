{"data":{"body":"[P1] `durable.operation.status: FAILED` means this callback completed unsuccessfully, so its OpenTelemetry span status must be `ERROR`; missing error details only removes descriptive or exception data. Requiring `UNSET` rejects conformant SDKs. Change this and the execution-view case-25 assertion to `ERROR`, then update the oracle tests and coverage text.","comment_node_id":"PRRC_kwDOTa1Cx87-UADI","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"f94d10af32b3edbfe3731ecabcbe7b033833b11bf4da64182b7ff2cb82ede6ae","observation_id":"aro_v1_7fgrblzswpw37y3td3flzpt3am","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-14T04:05:51Z","review_id":"arr_v1_k5gt6fzycetgnc3wiuxsv3o5fy","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"d8b8399264628dae57b7a96bf4cbf3e39a99fd8d","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_hktmqhzuqcpkpz4i3xprqil56f","record_type":"finding_observed","recorded_at":"2026-10-14T04:05:51Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
