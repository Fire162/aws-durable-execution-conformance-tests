{"data":{"body":"[P2] Case 25 can pass as soon as the first terminal callback record arrives, before S3 indexing exposes a delayed duplicate or record containing an exception event. That defeats the exact-one-leaf and zero-event assertions this case tests. Add a nonzero `quiescence_seconds` to both case-25 views and test a violating record arriving on a later lookup.","comment_node_id":"PRRC_kwDOTa1Cx87-xHCe","finding_digest":"dbd7d81430a97f8793e7af8eec8adc9b08e7c672eedc7a8bb87096fbbc247aa9","finding_id":"arf_v1_3pl5qfbqvf7ype7hv6hozcw4tm","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::telemetry-quiescence","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::telemetry-quiescence","line":229,"observation_digest":"ca7109d2c98c82aa3f9033fbc9ed4c170526d063c0fa052d94f445a401a387b1","observation_id":"aro_v1_zjyqtuwjrsbkup4qgp54t3kmc4","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"","published_at":"2026-10-14T17:48:43Z","review_id":"arr_v1_xscyycrypa6vknc33oasejms6l","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"f711bbfeb5464400d3aa1f8366e0bbb02087a67d","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_frczdjy3ehrsfny4kqms5bcx2t","record_type":"finding_observed","recorded_at":"2026-10-14T17:48:43Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
