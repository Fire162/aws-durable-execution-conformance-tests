{"data":{"body":"[P2] This disparity exemption is not honored when enumerating `$occurrence` candidates. On X-Ray or Datadog, a parent or resolved-link expectation combining `exception_event_count: 0` with `$occurrence` accepts the normalized `None` here, but the later `_matches_span` candidate check excludes the same span and `.index(...)` raises `ValueError`. Use one expectation-aware matcher for both checks and add parent/link occurrence tests with `EXCEPTION_EVENTS`.","comment_node_id":"PRRC_kwDOTa1Cx87-xHLQ","finding_digest":"7ffe9ace48bb0c373464e5c0bdeed654309ed6f5cecef9b9e827013025bf7c66","finding_id":"arf_v1_p77jvtsixmgdonde4xal33wwkq","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py::_span_expectation_errors::exception-disparity-occurrence-consistency","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py::_span_expectation_errors::exception-disparity-occurrence-consistency","line":340,"observation_digest":"4cabdad1700bf3aa2060186ab3bfd46d29e6da08c4404e561bf050a30272530e","observation_id":"aro_v1_jsv5vulqbpz2uidadbvlhp6unu","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/validators.py","prior_finding_id":"","published_at":"2026-10-14T17:48:46Z","review_id":"arr_v1_xscyycrypa6vknc33oasejms6l","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"f711bbfeb5464400d3aa1f8366e0bbb02087a67d","reviewer":"codex","start_line":335,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_shxe3zphwsvwaw5xzhhqbnosw3","record_type":"finding_observed","recorded_at":"2026-10-14T17:48:46Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
