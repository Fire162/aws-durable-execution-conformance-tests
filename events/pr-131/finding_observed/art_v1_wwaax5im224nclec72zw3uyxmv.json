{"data":{"body":"[P2] Preserve chained-invoke evidence when no trace is returned. `execution_trace_contexts` is populated before polling, but a no-correlated-trace timeout has `latest_trace is None`, so this branch writes no artifact and discards the observed child Root/Parent/Sampled values. Case 11 failures consequently lose the service-side evidence this change is intended to report. Write a context-only failure artifact whenever this mapping is non-empty, while continuing to include the latest trace when present, and add a regression test where a chained assertion's backend returns `None`.","comment_node_id":"PRRC_kwDOTa1Cx87--lay","finding_digest":"bb28f3e18ffccc4f7c4e42d1b2a7d4da5e1cba409022e194dbc71930282ce61e","finding_id":"arf_v1_xmuphymp7tge67coili3fj6u3j","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::service-context-artifact-loss","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::service-context-artifact-loss","line":299,"observation_digest":"a876c1d15ba5bfaba4a0285c027f194722d5a747d98ad7740e1d897a87b1d8cd","observation_id":"aro_v1_vb3mduk3uw72xjfafboae7yzi4","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py","prior_finding_id":"","published_at":"2026-10-15T00:45:30Z","review_id":"arr_v1_xceeegysvi4xgn73bpbdpxjlxu","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"896c36b6a4e65130886643b585b4dd928aa25544","reviewer":"codex","start_line":299,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_wwaax5im224nclec72zw3uyxmv","record_type":"finding_observed","recorded_at":"2026-10-15T00:45:30Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
