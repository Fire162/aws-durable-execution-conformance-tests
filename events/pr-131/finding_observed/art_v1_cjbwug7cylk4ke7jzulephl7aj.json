{"data":{"body":"[P1] The terminal callback is known to have `FAILED`, so OpenTelemetry requires Span Status `ERROR`; missing error details affect error attributes, not status. Requiring `UNSET` rejects conformant SDKs. Require `ERROR` here and in execution case 25, and update the corresponding tests and documentation while retaining the empty-payload history checks.","comment_node_id":"PRRC_kwDOTa1Cx87-Poms","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"d1c8b78a6c42104d84f8cb371da5d2c5e7f948b94c5650f269013f46ce36f89f","observation_id":"aro_v1_2helpctmiiie3bhyzm3r3josyx","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-14T00:28:05Z","review_id":"arr_v1_rvgyclghgu4itwwyrwmm736vkx","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"75987d46a915bc37409eed3ea9c3617a924c9756","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_cjbwug7cylk4ke7jzulephl7aj","record_type":"finding_observed","recorded_at":"2026-10-14T00:28:05Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
