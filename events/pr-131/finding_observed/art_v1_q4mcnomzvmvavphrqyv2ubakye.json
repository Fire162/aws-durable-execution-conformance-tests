{"data":{"body":"[P2] Gate this callback on completion of its creating invocation. `Delay` is only a wall-clock pause after discovery; if that invocation takes over one second to close, delivery occurs before `InvocationCompleted`, making the required PENDING-to-SUCCEEDED resume lifecycle timing-dependent. Add `AfterInvocationCompleted: true` here and in the paired execution requirement, with a regression where completion arrives after the delay.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAi2kvw","finding_digest":"459253fd7ab59152a306b0eec0284ff141f5ed905bae60f0439812b0ae4223c2","finding_id":"arf_v1_iwjfh7l2wwivfiygwdxmakcp6f","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-23.yaml::callbackactions::resume-boundary-gate","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-23.yaml::callbackactions::resume-boundary-gate","line":10,"observation_digest":"536dc714b96df7eb70c9b9b67be70d5d4eeea9e8c3406a4021f10bcf28371ca3","observation_id":"aro_v1_knw4offznx36w4gjxg3hxzynlv","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-23.yaml","prior_finding_id":"","published_at":"2026-10-20T23:43:31Z","review_id":"arr_v1_hjmdg4q7morfsafii5qostbiju","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"768ec7322df06df5339e8c77cfb078b47e5a547a","reviewer":"codex","start_line":10,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_q4mcnomzvmvavphrqyv2ubakye","record_type":"finding_observed","recorded_at":"2026-10-20T23:43:31Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
