{"data":{"body":"[P2] Preserve a trace observed before any backend failure, not only a quiescence timeout. With quiescence enabled, `_lookup()` can return a valid candidate and a later call can raise `BackendError`; `find_trace` propagates that error, and this type check forces `latest_trace` to `None`. Cases 21\u201326 can therefore fail with no normalized trace artifact (or a context-only artifact for case 11), even when trace artifacts were requested. Carry the last observed trace on every backend error raised after an observation and serialize it here; add a valid-first/error-second regression test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAiB3gg","finding_digest":"72ffdf9393819c4a060f49c1b2534064fe1994fe761cf10acb508196a51f688d","finding_id":"arf_v1_ol757e4tqgoeubqpjha3eu2amt","finding_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::generic-backend-latest-trace-loss","identity_key":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py::otelextension.validate_telemetry::generic-backend-latest-trace-loss","line":301,"observation_digest":"1d22a916742ab72003d8c670aa7c83da750812f6fc88abefeb2f3fabc2366e9e","observation_id":"aro_v1_durksftufk3saa6yyzyku7ed3j","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/extension.py","prior_finding_id":"","published_at":"2026-10-20T21:42:21Z","review_id":"arr_v1_mfq7p5qatj374qjpe2nexpz6i5","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"b174bcc41205990aa02e4c0e7ed29e770b30828d","reviewer":"codex","start_line":301,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_ehpgf33atifcfqsijaspbfhktt","record_type":"finding_observed","recorded_at":"2026-10-20T21:42:21Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},