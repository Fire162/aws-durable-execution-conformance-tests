{"data":{"body":"[P1] A callback with durable operation status `FAILED` has a failed outcome, so OpenTelemetry Span Status must be `ERROR`; omitting error details does not make the outcome unset. Requiring `UNSET` rejects conformant SDKs. Require `ERROR` here and in execution case 25, then update the corresponding oracle tests and documentation.","comment_node_id":"PRRC_kwDOTa1Cx87-RE76","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"7e5bc0ca8ec2d63a4cb5e64773a7aeb947fcc6a6f3c611f02c5f7fe5a35573ba","observation_id":"aro_v1_pzn4bsuoylldutfv4zdxhj5oxf","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-14T01:39:33Z","review_id":"arr_v1_yboyssvojck5b3n7imgxlym5wn","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"a1ba6a96298a252eb85bef43866ef1d3ccab66be","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_4t2w6m5sg54imzurntn5x2gkwb","record_type":"finding_observed","recorded_at":"2026-10-14T01:39:33Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
