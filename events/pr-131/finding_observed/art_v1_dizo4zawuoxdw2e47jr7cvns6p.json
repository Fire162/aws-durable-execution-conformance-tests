{"data":{"body":"[P2] Keep polling after the first passing context snapshot. This branch accepts an unresolved parent, so `$not` cannot reject a leaked `conformance.*` parent until that parent span arrives. With zero quiescence, the S3 backend can pass a child-only snapshot and miss the later forbidden parent. Add nonzero `quiescence_seconds` to both case-22 views and test a lookup sequence where the stale parent arrives after the handler span.","comment_node_id":"PRRC_kwDOTa1Cx87_FZZi","finding_digest":"a134873a912ff7d980eae15de93034a654299ec30ea37a6624cc9547fb9ff98d","finding_id":"arf_v1_ue2ioourf735tahk4fo6smbuuz","finding_key":"otel-context-22::handler-parent-alternatives::ambient-parent-identity","identity_key":"otel-context-22::handler-parent-alternatives::ambient-parent-identity","line":101,"observation_digest":"8af5dd3837cc7fc8a762fb71dc9fd67ab3a843a6dd91badea26dd68e9587f2f9","observation_id":"aro_v1_rl252obxzr74rj3c7ny5zh6wpk","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-22.yaml","prior_finding_id":"arf_v1_ue2ioourf735tahk4fo6smbuuz","published_at":"2026-10-15T05:59:44Z","review_id":"arr_v1_ajemhoxsg6a5c6kbfc4eywszsz","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"eb41c2c16ec8382fcd56db1754dd640c6855c020","reviewer":"codex","start_line":101,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_dizo4zawuoxdw2e47jr7cvns6p","record_type":"finding_observed","recorded_at":"2026-10-15T05:59:44Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
