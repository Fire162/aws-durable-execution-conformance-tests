{"data":{"body":"[P1] A callback whose durable status is `FAILED` completed unsuccessfully, so its OpenTelemetry Span Status must be `ERROR`; missing error details only affects descriptive data, not the outcome. Requiring `UNSET` rejects conformant SDKs. Require `ERROR` here and in execution case 25, then update the oracle tests and coverage documentation.","comment_node_id":"PRRC_kwDOTa1Cx87-SpLW","finding_digest":"87e8c578dd350a94c63f48231065ad9a4b22d01bbfd61b165d0aeccd2a77686f","finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml::failed-callback-terminal::otel-error-status","line":228,"observation_digest":"8caa3f80f8b16332eb4622e2a42501e3f760a94ca47105934b0745363973fbf2","observation_id":"aro_v1_rsvd7ahywfrtf22gelrkijib4p","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-invocation/otel-invocation-25.yaml","prior_finding_id":"arf_v1_q7umk6g5gufjjrr7jarraznntj","published_at":"2026-10-14T02:57:25Z","review_id":"arr_v1_mtuscxulznjlcmwf4wpdfy5jbb","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"fb69b21ccc8805a74271554403707f5e649e5aae","reviewer":"codex","start_line":228,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_hejxxxdem6njnt6bv52qknauxk","record_type":"finding_observed","recorded_at":"2026-10-14T02:57:25Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
