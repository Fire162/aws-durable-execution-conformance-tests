{"data":{"body":"[P2] Do not require zero exception events for this failed callback span. OpenTelemetry permits instrumentation to record an `exception` event when the failure escapes the callback span, even if the service supplied an empty error payload and the enclosing workflow catches it. This rejects otherwise conformant SDKs. Remove `exception_event_count: 0` from both case-25 views and update the associated tests/docs; retain the `ERROR` status assertion.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAjMMRA","finding_digest":"e842bbb16b1c4f62f714d395462fb3ab97f9cc07c57ead0717654a5014a33471","finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","line":246,"observation_digest":"f96878cc91fb008c54364add8f83e4ce5df900b33f98c74ba922b71647985379","observation_id":"aro_v1_7fuhrter7maiyvbwjloy7a7ezz","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml","prior_finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","published_at":"2026-10-21T00:45:40Z","review_id":"arr_v1_bi4rienvqouqvhomcxbhvze3oy","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"b7fd2fdea60942b5cba6c77d0ef454c01397d0c5","reviewer":"codex","start_line":246,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_jjixn4scyb4oa2amryyepltjur","record_type":"finding_observed","recorded_at":"2026-10-21T00:45:40Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
