{"data":{"body":"[P2] Reserve action indices while classifying terminal callbacks. With two same-name callbacks and actions `[immediate, gated]`, both lookups use the unchanged `used_action_indices`, so both select the immediate action and the undelivered gated action is never recorded; validation can pass after sending zero callbacks. Walk terminal callbacks with a temporary used-index set, reserving each match, and add a mixed-action terminal regression test.","comment_node_id":"PRRC_kwDOTa1Cx87-zfsO","finding_digest":"2b7af396577b362939c031bea244cca27f6eafcb7c938a5aebb3afc6cdda390b","finding_id":"arf_v1_fn5phfsxpm3csooagg7kergmuj","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::terminal-action-index-allocation","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::terminal-action-index-allocation","line":730,"observation_digest":"a5feea6492b14fe182f41e186ee210208b6e0b03a22a89148b8efe307893b8be","observation_id":"aro_v1_ux7ouzeswfh6daxudymg5yqqec","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py","prior_finding_id":"","published_at":"2026-10-14T18:50:06Z","review_id":"arr_v1_eqkwf2ivfjswaorgf6qj5d2vhf","reviewed_base_sha":"e48ac54502d3c14e2e3fa216c5e200dbb4c14ac2","reviewed_head_sha":"c0f6570ce8231b5abdd6e14b353447d6956a3556","reviewer":"codex","start_line":730,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_lnul7i4eat26mwyrzqrocsayfd","record_type":"finding_observed","recorded_at":"2026-10-14T18:50:06Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
