{"data":{"body":"[P2] Do not let history-only validation complete after sending a gated heartbeat while a follow-up action remains. The heartbeat clears `deferred_callback_ids` but deliberately leaves the callback unhandled, so this condition can immediately return success before the next poll allocates the configured success/failure action, leaving the execution suspended. Keep the callback pending when a heartbeat has another matching action, or process that follow-up in the same poll; add a history-only regression to the deferred-heartbeat test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAinSPg","finding_digest":"cb93db82bec60666c08837ecd3bd643a90d153f904db6020af943275a17e1b70","finding_id":"arf_v1_zoj5xav6yydgnqeig7wnhplehk","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::history-only-gated-heartbeat-followup","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::history-only-gated-heartbeat-followup","line":829,"observation_digest":"57f840f86a2cf699e13f0f4896f1b60fc85d2830cacd2dd41969c4bb755753ae","observation_id":"aro_v1_k74eb6dkft3jtyj7b5ejn4nwb7","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py","prior_finding_id":"","published_at":"2026-10-20T23:04:16Z","review_id":"arr_v1_sgyopo7wjknvo2j6v7kifmyb6o","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"c0663ecabd62413b8dacf8a549bcd730c8a1ce7b","reviewer":"codex","start_line":829,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_vtjrfq77vmn6ilezjkykq5vn2t","record_type":"finding_observed","recorded_at":"2026-10-20T23:04:16Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
