{"data":{"body":"[P2] Do not require zero exception events for this failure. OpenTelemetry permits recording a real exception that escapes the callback operation span, and an absent service error payload does not mean an SDK cannot raise such an exception. This therefore rejects conformant language implementations. Remove this assertion from both case-25 views; if fabricated service details are the concern, validate those event attributes specifically instead.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAjCW1Q","finding_digest":"e842bbb16b1c4f62f714d395462fb3ab97f9cc07c57ead0717654a5014a33471","finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","finding_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","identity_key":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml::failed-callback-expectation::exception-event-optionality","line":246,"observation_digest":"e8a7b2d02fc87c08e02a39df5d7035ba72fbc8deddd19eab658f01935bd990b7","observation_id":"aro_v1_5ct3fubpzb6arybkhhpv24bvxj","path":"packages/aws-durable-execution-conformance-tests-otel/test-requirements/otel-execution/otel-execution-25.yaml","prior_finding_id":"arf_v1_5bblxmlldrhwf5yu2okuml5tvo","published_at":"2026-10-21T00:16:53Z","review_id":"arr_v1_lv3gzst7umhixc4snreg4hkpfg","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"a047186f03d2d6c4c67bd33d3b9e9924fc0a8165","reviewer":"codex","start_line":246,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_jtt3tuanyjq66f6vymqsfvghst","record_type":"finding_observed","recorded_at":"2026-10-21T00:16:53Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
