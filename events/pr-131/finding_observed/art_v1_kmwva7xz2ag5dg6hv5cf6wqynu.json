{"data":{"body":"[P2] Do not let history-only validation complete immediately after a gated heartbeat. Sending the heartbeat clears `deferred_callback_ids` but deliberately leaves the callback unhandled, so this condition can return success before the next poll assigns and sends a configured follow-up success/failure action, leaving the execution suspended. Keep the callback pending when another action matches it, or process that follow-up during the same poll; add a history-only regression to the deferred-heartbeat test.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABAiwg8w","finding_digest":"cb93db82bec60666c08837ecd3bd643a90d153f904db6020af943275a17e1b70","finding_id":"arf_v1_zoj5xav6yydgnqeig7wnhplehk","finding_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::history-only-gated-heartbeat-followup","identity_key":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py::pollingvalidator.validate::history-only-gated-heartbeat-followup","line":829,"observation_digest":"e987d858d64cdd8f20aa5d905674081d7346b159094e89ecacd2168e7db0b554","observation_id":"aro_v1_5gd5qwgwjtoy6ifklwifm5aidv","path":"packages/aws-durable-execution-conformance-tests/src/aws_durable_execution_conformance_tests/validate.py","prior_finding_id":"arf_v1_zoj5xav6yydgnqeig7wnhplehk","published_at":"2026-10-20T23:27:25Z","review_id":"arr_v1_stktdivnc2fnjlo633nbx74sjv","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"c27adb2cd705249e6aa902fb1b9ef5fd59596622","reviewer":"codex","start_line":829,"suggestion_id":""},"pull_request":{"number":131},"record_id":"art_v1_kmwva7xz2ag5dg6hv5cf6wqynu","record_type":"finding_observed","recorded_at":"2026-10-20T23:27:25Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
