{"data":{"body":"[P2] Handle null OTLP event fields as unset. ProtoJSON permits `null` field values, so valid OTLP JSON containing `\"droppedEventsCount\": null` or `\"events\": null` now raises `TypeError` through `int(None)` or iteration over `None`. Previously these fields were ignored. This causes valid telemetry to fail normalization in the collector and Dash0 backends. Normalize null to zero or an empty event list before counting, and add tests for null and omitted fields.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABBBfY6A","finding_digest":"7400a96272cd4c510c2f8d037a248911852950c2eb59ea1bd3e0ce7f09859a9d","finding_id":"arf_v1_oqaksytszvgfcdbprubxujejcg","finding_key":"normalizers.py::normalize_otlp_json::null-event-fields","identity_key":"normalizers.py::normalize_otlp_json::null-event-fields","line":123,"observation_digest":"23a61f4eb335fa4ad81fafc6a639e98dee9608bf4e762e2151b9854247883ae8","observation_id":"aro_v1_eotb6tvtgx5evwa7v7dkmopjrx","path":"packages/aws-durable-execution-conformance-tests-otel/src/aws_durable_execution_conformance_tests_otel/normalizers.py","prior_finding_id":"","published_at":"2026-10-23T19:51:22Z","review_id":"arr_v1_o5grfifofi5524qcj35wr5aus3","reviewed_base_sha":"1808e8b0caa6f6f8f386b0ab41fa04cc01c1805b","reviewed_head_sha":"c32b40f5548f4776b7d533a76838e02358bc66d3","reviewer":"codex","start_line":122,"suggestion_id":"arsg_v1_pjser64ys3mv5i23gckpwe337v"},"pull_request":{"number":131},"record_id":"art_v1_gwm2cvdzfipa564tdj4cqlqcpq","record_type":"finding_observed","recorded_at":"2026-10-23T19:51:22Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
