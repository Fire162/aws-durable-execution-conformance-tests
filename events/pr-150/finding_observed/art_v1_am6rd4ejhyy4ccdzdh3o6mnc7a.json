{"data":{"body":"[P1] Use the SAM installer with Python 3.14\n\nThe preceding step activates Python 3.14, but this invocation selects setup-sam's default legacy pip bootstrap, which is incompatible with that interpreter. The job therefore fails during setup before reaching telemetry validation. The existing `.github/actions/prepare-otel-example/action.yml` handles this compatibility issue with `use-installer: true`; enable the same option here.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABBDVV1w","finding_digest":"8e7d2f2a6f05d7d555967acb8bf1480a2ede1475a2a428f1218f6c69d6d6559d","finding_id":"arf_v1_rz6s6ktpaxl5kvmwplfyx4kibi","finding_key":"github/workflows/telemetry-suite.yml::setup-sam::python314-bootstrap-compatibility","identity_key":"github/workflows/telemetry-suite.yml::setup-sam::python314-bootstrap-compatibility","line":160,"observation_digest":"c532c8d5f25c45cf56f2e260de37badfbdaa78a7f3d60b28c8d28663e030348d","observation_id":"aro_v1_yuzmrvpslrc46vxs4jqn4n5236","path":".github/workflows/telemetry-suite.yml","prior_finding_id":"","published_at":"2026-10-24T01:46:46Z","review_id":"arr_v1_beflfuownozep267wo7qjdxvdn","reviewed_base_sha":"0906c788783a5918e778e5ab8dc878683be43a1b","reviewed_head_sha":"3e4fdaf0dda35ed8f64fb0d18365ef05a6a447fe","reviewer":"codex","start_line":159,"suggestion_id":"arsg_v1_mbqv5mrev3pfcwjrstakmlfkrc"},"pull_request":{"number":150},"record_id":"art_v1_am6rd4ejhyy4ccdzdh3o6mnc7a","record_type":"finding_observed","recorded_at":"2026-10-24T01:46:46Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
