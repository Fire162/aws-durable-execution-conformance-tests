{"data":{"body":"**[P3] Normalize record order before positional matching**\n\nThe core retriever accumulates events in first-observed poll order. If an earlier record becomes visible after a later one, it is appended and this function preserves the reversed order, causing positional multi-record assertions to fail nondeterministically. Sort records by CloudWatch timestamp/ingestion ordering before validation, or match them using a stable semantic key, and test late arrival of an earlier record.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABArnffg","finding_digest":"e459e37ce396d48e2d3d2ab4eb063766035784df2289eaa62b22b5a28a6ee82d","finding_id":"arf_v1_4rm6g7hds3ki4lj5fk2owbrxmy","finding_key":"telemetry/retrieval.py::fetch_records::unstable-positional-order","identity_key":"telemetry/retrieval.py::fetch_records::unstable-positional-order","line":72,"observation_digest":"ebdb2b19a5249c77b28f72d939f994d1cf7a409e0ad773fd28a01d50a5716634","observation_id":"aro_v1_5pnswgnfesohpmupolmtt6mu2h","path":"packages/aws-durable-execution-conformance-tests-telemetry/src/aws_durable_execution_conformance_tests_telemetry/retrieval.py","prior_finding_id":"","published_at":"2026-10-21T18:53:26Z","review_id":"arr_v1_fm7oviql6wego5jpcnduindzqh","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"765d19140bc5a0ca60870695fcd82c9fb22cfba5","reviewer":"codex","start_line":63,"suggestion_id":""},"pull_request":{"number":144},"record_id":"art_v1_yns6d3ibmvqcb6ufva7invcjso","record_type":"finding_observed","recorded_at":"2026-10-21T18:53:26Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
