{"data":{"body":"**[P2] Write artifacts on failure paths too**\n\nAll earlier returns\u2014including malformed assertions, ARN/region failures, and CloudWatch access errors\u2014bypass this write, contradicting the documented \u201cevery run, pass or fail\u201d lifecycle and removing diagnostics when they are most useful. Accumulate the failure state and write an artifact in a `finally`-style path, preserving partial CloudWatch events where available.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABArndFQ","finding_digest":"6285729578bc2af679b8f7b409c1c3466bb44cfe24da00237cd4cbf3bb6af36b","finding_id":"arf_v1_mkcxfflyxqvpm6ny662atqodiz","finding_key":"telemetry/extension.py::validate_telemetry::failure-artifact-omission","identity_key":"telemetry/extension.py::validate_telemetry::failure-artifact-omission","line":136,"observation_digest":"52688595481c79325021eee160272b233be88f20b552de0020f992f19c02ed08","observation_id":"aro_v1_kjuilfkidr4teubb53qwajzlem","path":"packages/aws-durable-execution-conformance-tests-telemetry/src/aws_durable_execution_conformance_tests_telemetry/extension.py","prior_finding_id":"","published_at":"2026-10-21T18:53:21Z","review_id":"arr_v1_fm7oviql6wego5jpcnduindzqh","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"765d19140bc5a0ca60870695fcd82c9fb22cfba5","reviewer":"codex","start_line":134,"suggestion_id":""},"pull_request":{"number":144},"record_id":"art_v1_ovcktmv55tkrswxhotur7wibyo","record_type":"finding_observed","recorded_at":"2026-10-21T18:53:21Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
