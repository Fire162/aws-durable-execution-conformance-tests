{"data":{"body":"**[P2] Validate duration values beyond field presence**\n\n`'*'` accepts every present value, so an otherwise valid record with `durationMs: null` and boolean values for `minDurationMs`, `maxDurationMs`, and `totalDurationMs` passes this requirement. An exporter with broken duration serialization therefore passes the complete-success-record check. Require finite, non-negative numeric values, excluding booleans, for all four duration fields and add invalid-value tests against the shipped requirement.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABA5avbQ","finding_digest":"8c91063332809ae5f228e1eaa6b3c4fce4ea27dd051b356a7ad5af70fac47040","finding_id":"arf_v1_rsiqmmzsqcnol4ri4hvknm6e7t","finding_key":"telemetry/telemetry-1.yaml::telemetryassertions::incomplete-record-schema","identity_key":"telemetry/telemetry-1.yaml::telemetryassertions::incomplete-record-schema","line":43,"observation_digest":"dfa87725ff3de399b4e117eb90520e6f608a0da7806920fddf7feb1a2bcad301","observation_id":"aro_v1_36uhojp7hxrztnhbc7vzauqon5","path":"packages/aws-durable-execution-conformance-tests-telemetry/test-requirements/telemetry/telemetry-1.yaml","prior_finding_id":"arf_v1_rsiqmmzsqcnol4ri4hvknm6e7t","published_at":"2026-10-23T01:16:07Z","review_id":"arr_v1_5li5vfh6aybuldn7qgve2eybve","reviewed_base_sha":"eae1a45ee3c1fdfea4e2567071c5f7455e1e1b05","reviewed_head_sha":"483dcaab7dcea253957cab81016c7fe9261f6b40","reviewer":"codex","start_line":43,"suggestion_id":""},"pull_request":{"number":144},"record_id":"art_v1_jp4nhjrn4z7loic6eri7jpbq5c","record_type":"finding_observed","recorded_at":"2026-10-23T01:16:07Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
