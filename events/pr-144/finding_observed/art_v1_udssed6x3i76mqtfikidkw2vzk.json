{"data":{"body":"**[P2] Avoid consuming the full default polling window**\n\n`CloudWatchLogRetriever` defaults to 120 seconds, and calls without a `completion_check` always consume that full window. Consequently, even an immediately available record takes roughly 130 seconds including the default pre-wait, and `--log-poll-timeout` is ignored. Pass the configured timeout and a completion predicate based on the expected record snapshot, with a fake-clock test proving early settlement.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABArnbtA","finding_digest":"a7d77f3407761aae7dd34308d9111cb42010a2c088b74c05083fbf4c842c7487","finding_id":"arf_v1_u7lx6nahoynk47otimensei4wq","finding_key":"telemetry/extension.py::validate_telemetry::unbounded-default-polling","identity_key":"telemetry/extension.py::validate_telemetry::unbounded-default-polling","line":122,"observation_digest":"9d36e1e2fbcbcd2c77d24ff80dbb7a08bbb25b3030c9a16aadbdc5e937dd874d","observation_id":"aro_v1_tu3odyx3zpgsy56sj74a3o32bc","path":"packages/aws-durable-execution-conformance-tests-telemetry/src/aws_durable_execution_conformance_tests_telemetry/extension.py","prior_finding_id":"","published_at":"2026-10-21T18:53:19Z","review_id":"arr_v1_fm7oviql6wego5jpcnduindzqh","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"765d19140bc5a0ca60870695fcd82c9fb22cfba5","reviewer":"codex","start_line":119,"suggestion_id":""},"pull_request":{"number":144},"record_id":"art_v1_udssed6x3i76mqtfikidkw2vzk","record_type":"finding_observed","recorded_at":"2026-10-21T18:53:19Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
