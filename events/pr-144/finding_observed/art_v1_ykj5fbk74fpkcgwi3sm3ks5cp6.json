{"data":{"body":"**[P1] Validate the complete telemetry schema**\n\nThis \u201ccomplete success record\u201d assertion permits records missing required envelope fields such as `emittedAt`, `executionName`, `startTime`, `endTime`, and `durationMs`, along with operation timing/attempt summaries. Because the validator ignores unlisted fields, such an incomplete record passes conformance. Add required-field/type/consistency checks and omission tests for the complete schema.","comment_node_id":"PRRC_kwDOTa1Cx88AAAABArnZLA","finding_digest":"8c91063332809ae5f228e1eaa6b3c4fce4ea27dd051b356a7ad5af70fac47040","finding_id":"arf_v1_rsiqmmzsqcnol4ri4hvknm6e7t","finding_key":"telemetry/telemetry-1.yaml::telemetryassertions::incomplete-record-schema","identity_key":"telemetry/telemetry-1.yaml::telemetryassertions::incomplete-record-schema","line":43,"observation_digest":"adc98fb8bab7d1edba81554043af3a89beecbcec1efb422c243224a2565ae97b","observation_id":"aro_v1_vxey7of2w7i63oubkvaehlz2rg","path":"packages/aws-durable-execution-conformance-tests-telemetry/test-requirements/telemetry/telemetry-1.yaml","prior_finding_id":"","published_at":"2026-10-21T18:53:15Z","review_id":"arr_v1_fm7oviql6wego5jpcnduindzqh","reviewed_base_sha":"37656dd6f43d565d8e90e22f3554faa7c92dcb01","reviewed_head_sha":"765d19140bc5a0ca60870695fcd82c9fb22cfba5","reviewer":"codex","start_line":37,"suggestion_id":""},"pull_request":{"number":144},"record_id":"art_v1_ykj5fbk74fpkcgwi3sm3ks5cp6","record_type":"finding_observed","recorded_at":"2026-10-21T18:53:15Z","repository":{"full_name":"aws/aws-durable-execution-conformance-tests","id":1303200455},"schema_version":1}
